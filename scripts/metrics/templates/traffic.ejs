<% const traffic = plugins.traffic; if (traffic) { const number = value => new Intl.NumberFormat('en-US').format(value); %>
<section class="traffic-card">
  <h2 class="field rl-head"><span class="tag">Repository traffic</span><small class="zh">仓库访问</small><% if (traffic.available) { %><span class="readout">CAPTURED <%= traffic.capturedAt.slice(0, 10) %></span><% } %></h2>
  <% if (!traffic.available) { %>
    <p class="t-empty">&gt; <%= traffic.message %></p>
  <% } else { const W = 460, top = 18, base = 92, H = 112, step = W / traffic.days.length, best = Math.max(...traffic.days.map(d => d.count)); %>
    <div class="t-total"><b><%= number(traffic.totalViews) %></b><small>PAGE VIEWS</small></div>
    <div class="t-sub"><span>Daily reported views · UTC</span><span><%= traffic.periodLabel %></span></div>
    <svg class="t-chart" xmlns="http://www.w3.org/2000/svg" width="<%= W %>" height="<%= H %>" viewBox="0 0 <%= W %> <%= H %>" role="img" aria-label="Daily repository page views">
      <% for (const f of [0.5, 1]) { %><line class="grid" x1="0" x2="<%= W %>" y1="<%= base - (base - top) * f %>" y2="<%= base - (base - top) * f %>"/><% } %>
      <% for (let i = 0; i < traffic.days.length; i++) { const day = traffic.days[i]; const h = day.count ? Math.max(2, (base - top) * day.count / traffic.maxDayCount) : 0; const x = i * step + 3, w = Math.max(1, step - 6), peak = day.count > 0 && day.count === best; %>
        <% if (h) { %><rect class="bar<%= peak ? ' is-best' : '' %>" x="<%= x + 0.5 %>" y="<%= base - h + 0.5 %>" width="<%= w - 1 %>" height="<%= h - 0.5 %>"><title><%= day.date %>: <%= number(day.count) %> views</title></rect><% } %>
        <% if (peak) { %><text class="peak" x="<%= x + w / 2 %>" y="<%= base - h - 5 %>" text-anchor="middle"><%= number(day.count) %></text><% } %>
        <text x="<%= x + w / 2 %>" y="<%= base + 14 %>" text-anchor="middle"><%= day.date.slice(8) %></text>
      <% } %>
      <line class="base" x1="0" x2="<%= W %>" y1="<%= base + 0.5 %>" y2="<%= base + 0.5 %>"/>
    </svg>
    <% const topRepo = Math.max(1, ...traffic.repositories.map(r => r.count)); %>
    <ul class="t-repos">
      <% for (const [n, repo] of traffic.repositories.entries()) { %>
        <li class="<%= n === 0 && repo.count > 0 ? 'is-hi' : '' %>" style="--v:<%= (repo.count / topRepo).toFixed(3) %>">
          <span><%= repo.name %></span><b><%= number(repo.count) %></b><i></i>
          <% if (repo.periodLabel !== traffic.periodLabel) { %><small><%= repo.periodLabel %></small><% } %>
        </li>
      <% } %>
    </ul>
    <p class="t-foot"><%= traffic.repositoryCount %> public repositories<%= traffic.complete ? '' : ' · partial snapshot coverage' %> · github traffic api</p>
  <% } %>
</section>
<% } %>
